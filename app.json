{
  "expo": {
    "name": "VoiceGuard",
    "slug": "voiceguard",
    "owner": "lafunacorp",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A12",
    "splash": {
      "backgroundColor": "#070A12",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.personal.voiceguard",
      "adaptiveIcon": {
        "backgroundColor": "#070A12"
      },
      "versionCode": 3,
      "permissions": ["RECORD_AUDIO", "VIBRATE"]
    },
    "ios": {
      "bundleIdentifier": "com.personal.voiceguard",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VoiceGuard потребує мікрофону для аналізу гучності та темпу мовлення."
      }
    },
    "extra": {
      "eas": {
        "projectId": "ec85f93f-3ae9-44ae-93f8-d1e735e7b5db"
      }
    }
  }
}
