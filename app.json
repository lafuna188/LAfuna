{
  "expo": {
    "name": "VoiceGuard",
    "slug": "voiceguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A12",
    "splash": {
      "backgroundColor": "#070A12",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.personal.voiceguard",
      "adaptiveIcon": {
        "backgroundColor": "#070A12"
      },
      "versionCode": 1,
      "permissions": ["RECORD_AUDIO", "VIBRATE"]
    },
    "ios": {
      "bundleIdentifier": "com.personal.voiceguard",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VoiceGuard потребує мікрофону для аналізу гучності та темпу мовлення."
      }
    },
    "extra": {
      "eas": {
        "projectId": "437d666c-e87c-471e-8cf2-8185c1c4f145"
      }
    }
  }
}
